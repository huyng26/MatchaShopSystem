APP_NAME=Matcha Shop Backend
APP_ENV=development
DEBUG=true

POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=matcha_management_system
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://admin:password@db:5432/matcha_management_system

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SHOP_LATITUDE=21.0061832
SHOP_LONGITUDE=105.8405558
MAPS_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
MAPS_REQUEST_TIMEOUT_SECONDS=8
SHIPPER_LOCATION_UPDATE_INTERVAL_SECONDS=30

SEED_ADMIN_EMAIL=admin@matcha.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_PHONE=0900000001
