APP_NAME=Matcha Shop Backend
APP_ENV=development
DEBUG=true

POSTGRES_USER=matcha
POSTGRES_PASSWORD=matcha_secret
POSTGRES_DB=matcha_shop
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://matcha:matcha_secret@db:5432/matcha_shop

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
